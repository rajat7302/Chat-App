<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Set New Password</title>
</head>
<body>
    <div style="max-width: 400px; margin: 50px auto; font-family: Arial, sans-serif;">
        <h2>Create New Password</h2>
        <form action="/user/reset-password/<%= token %>" method="POST">
            <div style="margin-bottom: 15px;">
                <label>New Password:</label><br>
                <input 
                    type="password" 
                    name="password" 
                    required 
                    placeholder="At least 8 chars, 1 upper, 1 number, 1 special"
                    style="width: 100%; padding: 8px; margin-top: 5px;"
                >
            </div>
            <button type="submit" style="padding: 10px 15px; background: #007bff; color: white; border: none; cursor: pointer;">
                Update Password
            </button>
        </form>
    </div>
</body>
</html>